<?xml version="1.0"?>
<!--
  Unitree D1-T (d1_550) arm, ported from the vendor package d1_550_description
  (ROS1/catkin + Gazebo Classic, obtained from Unitree's CDN) to a ROS2 xacro
  macro. Link/joint geometry, inertials and joint limits are carried over
  as-is from the vendor URDF (SolidWorks URDF Exporter output) except for:
    - all link/joint names prefixed with ${prefix} to avoid collisions with
      the Go2 body's own link/joint names (e.g. vendor "base_link")
    - mesh paths rewritten to this package's xacro $(find) convention

  KNOWN UNVERIFIED (see docs/計画/アーム動作.md §4-5, §5 in Go2_deploy, Issue #65):
    - joint axis directions are taken from the vendor file as-is and have NOT
      been checked against the real D1-T hardware yet (Caltech AMBER Lab's
      report on the same vendor URDF found 2 axes did not match their unit).
      Verify by eye once real hardware arrives, before trusting IK/FK built
      on this model.
    - the mount origin (xyz/rpy passed in by the caller) is a placeholder;
      the real static TF requires a physical measurement of the arm's
      rear-mount position on Go2, not yet done.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="d1_arm" params="parent prefix:=d1_ xyz:='0 0 0' rpy:='0 0 0'">

    <joint name="${prefix}mount_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
    </joint>

    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-9.0106E-05 -0.00012378 0.033469" rpy="0 0 0"/>
        <mass value="0.16964"/>
        <inertia ixx="0.00030483" ixy="1.2051E-06" ixz="3.9736E-06"
                 iyy="0.00031037" iyz="8.0144E-07" izz="0.00050913"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/base_link.STL"/>
        </geometry>
        <material name="d1_grey">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/base_link.STL"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}link1">
      <inertial>
        <origin xyz="-0.0030892 6.1834E-05 0.031665" rpy="0 0 0"/>
        <mass value="0.14706"/>
        <inertia ixx="7.8054E-05" ixy="1.9698E-10" ixz="-1.574E-08"
                 iyy="6.6897E-05" iyz="-4.3439E-09" izz="7.0773E-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link1.STL"/>
        </geometry>
        <material name="d1_grey">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link1.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint1" type="revolute">
      <origin xyz="0 0 0.0738" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link1"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-2.36" upper="2.36" effort="3.33" velocity="1.05"/>
    </joint>

    <link name="${prefix}link2">
      <inertial>
        <origin xyz="5.7801E-05 0.027243 0.19413" rpy="0 0 0"/>
        <mass value="0.20987"/>
        <inertia ixx="0.00025832" ixy="-2.101E-11" ixz="-1.4864E-07"
                 iyy="0.00023175" iyz="-4.425E-09" izz="6.5679E-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link2.STL"/>
        </geometry>
        <material name="d1_grey">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link2.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint2" type="revolute">
      <origin xyz="0 -0.0276 0.0578" rpy="0 0 0"/>
      <parent link="${prefix}link1"/>
      <child link="${prefix}link2"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="3.33" velocity="1.05"/>
    </joint>

    <link name="${prefix}link3">
      <inertial>
        <origin xyz="0.016105 0.0275 0.044231" rpy="0 0 0"/>
        <mass value="0.064921"/>
        <inertia ixx="2.0648E-05" ixy="-3.9865E-11" ixz="-2.0913E-06"
                 iyy="1.6024E-05" iyz="-5.5601E-11" izz="1.2186E-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link3.STL"/>
        </geometry>
        <material name="d1_grey">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link3.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint3" type="revolute">
      <origin xyz="0 -0.0004 0.27" rpy="0 0 0"/>
      <parent link="${prefix}link2"/>
      <child link="${prefix}link3"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="3.33" velocity="1.05"/>
    </joint>

    <link name="${prefix}link4">
      <inertial>
        <origin xyz="0.096072 3.157E-05 0.00025559" rpy="0 0 0"/>
        <mass value="0.081362"/>
        <inertia ixx="1.6724E-05" ixy="-5.5957E-08" ixz="9.45E-08"
                 iyy="5.1663E-05" iyz="1.6089E-12" izz="6.1415E-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link4.STL"/>
        </geometry>
        <material name="d1_grey">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link4.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint4" type="revolute">
      <origin xyz="0.05 0.0275 0.041325" rpy="0 0 0"/>
      <parent link="${prefix}link3"/>
      <child link="${prefix}link4"/>
      <axis xyz="1 0 0"/>
      <limit lower="-2.36" upper="2.36" effort="1.67" velocity="1.73"/>
    </joint>

    <link name="${prefix}link5">
      <inertial>
        <origin xyz="0.044211 0.025813 0.0054296" rpy="0 0 0"/>
        <mass value="0.059846"/>
        <inertia ixx="1.4667E-05" ixy="-4.9109E-10" ixz="-4.7057E-07"
                 iyy="1.2009E-05" iyz="1.4753E-09" izz="9.9767E-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link5.STL"/>
        </geometry>
        <material name="d1_grey">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link5.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint5" type="revolute">
      <origin xyz="0.15468 -0.0258 0.0001" rpy="0 0 0"/>
      <parent link="${prefix}link4"/>
      <child link="${prefix}link5"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.57" upper="1.57" effort="1.67" velocity="1.73"/>
    </joint>

    <link name="${prefix}link6">
      <inertial>
        <origin xyz="0.03844 -0.00044094 0.0060952" rpy="0 0 0"/>
        <mass value="0.12117"/>
        <inertia ixx="0.00011988" ixy="-9.0166E-08" ixz="1.1937E-06"
                 iyy="3.2466E-05" iyz="-2.1696E-09" izz="0.0001058"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link6.STL"/>
        </geometry>
        <material name="d1_grey">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link6.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint6" type="revolute">
      <origin xyz="0.0777 0.025822 -0.0010718" rpy="0 0 0"/>
      <parent link="${prefix}link5"/>
      <child link="${prefix}link6"/>
      <axis xyz="1 0 0"/>
      <limit lower="-2.36" upper="2.36" effort="1.67" velocity="1.73"/>
    </joint>

    <link name="${prefix}link_l">
      <inertial>
        <origin xyz="0.018562 -0.0073492 -0.0034988" rpy="0 0 0"/>
        <mass value="0.01333"/>
        <inertia ixx="1.0229E-06" ixy="-1.5002E-07" ixz="1.3407E-11"
                 iyy="2.3789E-06" iyz="-1.3846E-14" izz="1.8134E-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link_L.STL"/>
        </geometry>
        <material name="d1_grey">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link_L.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_l" type="prismatic">
      <origin xyz="0.0718 -0.033778 0.0031" rpy="0 0 0"/>
      <parent link="${prefix}link6"/>
      <child link="${prefix}link_l"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="0.033" effort="15" velocity="0.02"/>
    </joint>

    <link name="${prefix}link_r">
      <inertial>
        <origin xyz="0.018562 0.0073492 -0.0035012" rpy="0 0 0"/>
        <mass value="0.01333"/>
        <inertia ixx="1.0229E-06" ixy="1.5002E-07" ixz="-1.3407E-11"
                 iyy="2.3789E-06" iyz="-1.3811E-14" izz="1.8134E-06"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link_R.STL"/>
        </geometry>
        <material name="d1_grey">
          <color rgba="0.79216 0.81961 0.93333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find d1_550_description)/meshes/Empty_Link_R.STL"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_r" type="prismatic">
      <origin xyz="0.0718 0.033022 0.0031" rpy="0 0 0"/>
      <parent link="${prefix}link6"/>
      <child link="${prefix}link_r"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0" upper="0.033" effort="15" velocity="0.02"/>
    </joint>

  </xacro:macro>
</robot>
